# Browser-safe Supabase configuration. Copy to .env.local for local development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Legacy projects can use SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY.
# Never put a service_role or sb_secret_ key in either public key variable.
